  "title": "[SwiftHFR] Success confirmations dismiss themselves after 4 s (not under VoiceOver)",
  "user": {
   "login": "francoisgn",
   "id": 32835330,
   "node_id": "MDQ6VXNlcjMyODM1MzMw",
   "avatar_url": "https://avatars.githubusercontent.com/u/32835330?v=4",
   "gravatar_id": "",
