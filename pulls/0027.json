   "gists_url": "https://api.github.com/users/francoisgn/gists{/gist_id}",
   "starred_url": "https://api.github.com/users/francoisgn/starred{/owner}{/repo}",
   "subscriptions_url": "https://api.github.com/users/francoisgn/subscriptions",
