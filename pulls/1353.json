  "title": "[SwiftHFR] Offline-save banner: 44 pt hit region for the ✕ (#1329)",
  "user": {
   "login": "francoisgn",
   "id": 32835330,
   "node_id": "MDQ6VXNlcjMyODM1MzMw",
