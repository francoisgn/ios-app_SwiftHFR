  "title": "[SwiftHFR] Reader \"…\" menu: Rechercher first, page items last (legacy order)",
  "user": {
   "login": "francoisgn",
   "id": 32835330,
   "node_id": "MDQ6VXNlcjMyODM1MzMw",
   "avatar_url": "https://avatars.githubusercontent.com/u/32835330?v=4",
   "gravatar_id": "",
   "url": "https://api.github.com/users/francoisgn",
   "html_url": "https://github.com/francoisgn",
