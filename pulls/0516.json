  "title": "Composer: focus the first empty field once the draft is read",
  "user": {
   "login": "francoisgn",
   "id": 32835330,
   "node_id": "MDQ6VXNlcjMyODM1MzMw",
   "avatar_url": "https://avatars.githubusercontent.com/u/32835330?v=4",
