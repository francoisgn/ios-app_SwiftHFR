  "title": "[SwiftHFR] Réglages ⓘ bubbles: a scrollable sheet on compact width, the popover on wide views (#1181)",
  "user": {
   "login": "francoisgn",
   "id": 32835330,
   "node_id": "MDQ6VXNlcjMyODM1MzMw",
   "avatar_url": "https://avatars.githubusercontent.com/u/32835330?v=4",
