  "locked": false,
  "title": "[SwiftHFR] ReaderSettingsWatch: never deliver a change after stop() (flaky test #839)",
  "user": {
   "login": "francoisgn",
   "id": 32835330,
   "node_id": "MDQ6VXNlcjMyODM1MzMw",
   "avatar_url": "https://avatars.githubusercontent.com/u/32835330?v=4",
   "gravatar_id": "",
   "url": "https://api.github.com/users/francoisgn",
   "html_url": "https://github.com/francoisgn",
   "followers_url": "https://api.github.com/users/francoisgn/followers",
   "following_url": "https://api.github.com/users/francoisgn/following{/other_user}",
