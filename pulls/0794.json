  "title": "[SwiftHFR] Fixture anonymizer: end a signature by its structure, check what follows it, refuse svg/math (#763)",
  "user": {
   "login": "francoisgn",
   "id": 32835330,
   "node_id": "MDQ6VXNlcjMyODM1MzMw",
   "avatar_url": "https://avatars.githubusercontent.com/u/32835330?v=4",
