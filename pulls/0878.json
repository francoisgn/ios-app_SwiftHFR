  "number": 878,
  "state": "closed",
  "locked": false,
  "title": "[SwiftHFR] Reader: give the web view the real top and bottom insets (last lines no longer under the bottom controls)",
  "user": {
   "login": "francoisgn",
   "id": 32835330,
   "node_id": "MDQ6VXNlcjMyODM1MzMw",
   "avatar_url": "https://avatars.githubusercontent.com/u/32835330?v=4",
   "gravatar_id": "",
   "url": "https://api.github.com/users/francoisgn",
   "html_url": "https://github.com/francoisgn",
   "followers_url": "https://api.github.com/users/francoisgn/followers",
   "following_url": "https://api.github.com/users/francoisgn/following{/other_user}",
   "gists_url": "https://api.github.com/users/francoisgn/gists{/gist_id}",
   "starred_url": "https://api.github.com/users/francoisgn/starred{/owner}{/repo}",
   "subscriptions_url": "https://api.github.com/users/francoisgn/subscriptions",
   "organizations_url": "https://api.github.com/users/francoisgn/orgs",
   "repos_url": "https://api.github.com/users/francoisgn/repos",
